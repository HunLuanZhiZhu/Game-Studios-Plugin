{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "blender": {
      "type": "stdio",
      "command": "blender-mcp",
      "args": [
        "--host",
        "localhost",
        "--port",
        "9876"
      ]
    },
    "open-design": {
      "type": "stdio",
      "command": "bash",
      "args": [
